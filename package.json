{
  "name": "interior-project-pro",
  "version": "2.0.0",
  "private": true,
  "description": "AI photography and interior rating app with secure backend, SQLite database, comparison mode, sharing, and export.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c auto \"vite --host 0.0.0.0\" \"nodemon server/server.mjs\"",
