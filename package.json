    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.8",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "vite": "^5.4.14"
  }
